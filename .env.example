# Copy this file to .env and fill in the values. Never commit .env.

# development | production
APP_ENV=development

# Signs session cookies and CSRF tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to a SQLite file in instance/voicebox.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost/voicebox

# Optional. Comma-separated e-mail domains allowed to register. Empty = any.
# ALLOWED_EMAIL_DOMAINS=students.cavendish.example
